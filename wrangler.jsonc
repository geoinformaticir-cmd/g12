{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "g12",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "01164d93-e825-48c6-9c18-43b2fa5087a8","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c6e9f4456a2f4134a4a20892e44f50b1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
